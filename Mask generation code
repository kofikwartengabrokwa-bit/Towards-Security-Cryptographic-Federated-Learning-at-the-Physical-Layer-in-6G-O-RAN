        print(f"  Total aggregation latency  : {avg_u_total:.4f} ms")
        print(f"  Accuracy                   : {avg_u_acc:.4f} %")
        print(f"  Efficiency                 : {avg_u_eff:.6f}")

        print(f"\nServer-generated Mask IDs:")
        print(f"  Mask-ID generation latency : {avg_s_mask:.4f} ms")
        print(f"  Total aggregation latency  : {avg_s_total:.4f} ms")
        print(f"  Accuracy                   : {avg_s_acc:.4f} %")
        print(f"  Efficiency                 : {avg_s_eff:.6f}")

    # -----------------------------------------------------------------------------------------------
    # Convert to NumPy arrays
    # -----------------------------------------------------------------------------------------------

    user_mask_latency = np.array(user_mask_latency)
    server_mask_latency = np.array(server_mask_latency)

    user_total_latency = np.array(user_total_latency)
    server_total_latency = np.array(server_total_latency)

    user_accuracy = np.array(user_accuracy)
    server_accuracy = np.array(server_accuracy)

    user_efficiency = np.array(user_efficiency)
    server_efficiency = np.array(server_efficiency)

    # -----------------------------------------------------------------------------------------------
    # Final summary
    # -----------------------------------------------------------------------------------------------

    print("\n\n")
    print("=" * 115)
    print("FINAL COMPARISON")
    print("=" * 115)

    print(
        f"{'Users':>10}"
        f"{'User Latency':>20}"
        f"{'Server Latency':>20}"
        f"{'User Acc.':>18}"
        f"{'Server Acc.':>18}"
        f"{'User Eff.':>18}"
        f"{'Server Eff.':>18}"
