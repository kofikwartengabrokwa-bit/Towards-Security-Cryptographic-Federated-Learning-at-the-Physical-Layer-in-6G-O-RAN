# GLOBAL CONFIGURATION
# ----------------------------------------------------------------------------------------------------

RANDOM_SEED = 42
np.random.seed(RANDOM_SEED)

# Number of users to evaluate
USER_COUNTS = [100, 200, 400, 600, 800, 1000]

# Number of experimental repetitions
NUM_TRIALS = 15

# Length of cryptographic mask ID
MASK_ID_BYTES = 100

# Simulated model dimension
MODEL_DIMENSION = 15

