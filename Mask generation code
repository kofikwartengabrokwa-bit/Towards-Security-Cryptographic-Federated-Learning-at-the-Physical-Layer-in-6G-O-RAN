# ====================================================================================================
# MASK-ID GENERATION FUNCTIONS
# ====================================================================================================

def generate_mask_id_user():
    """
    Generate a masking ID at the user side.

    Each user independently creates its own cryptographically
    random masking identifier.
    """

    mask_id = secrets.token_bytes(MASK_ID_BYTES)

    # Hash the random value to obtain a fixed-size identifier
    mask_id = hashlib.sha256(mask_id).hexdigest()

    return mask_id


def generate_mask_ids_server(num_users):
    """
    Generate all masking IDs centrally at the O-DU security masker.

    One server generates IDs for all participating users.
    """

    mask_ids = {}

    for user_id in range(num_users):

        random_value = secrets.token_bytes(MASK_ID_BYTES)

        mask_id = hashlib.sha256(random_value).hexdigest()

        mask_ids[user_id] = mask_id

    return mask_ids


# ====================================================================================================
# SIMULATED LOCAL MODEL UPDATE
# ====================================================================================================

def generate_local_update(user_id, model_dimension=MODEL_DIMENSION):
    """
    Generate a simulated local model update.

    In the actual FL implementation, this should be replaced by
    the local FedProx/LSTM/SAC model update.
    """

    rng = np.random.default_rng(RANDOM_SEED + user_id)

    update = rng.normal(
        loc=0.0,
        scale=0.01,
        size=model_dimension
    )

    return update


# ====================================================================================================
# MASKING FUNCTION
# ====================================================================================================

def mask_local_update(local_update, mask_seed):
    """
    Apply a deterministic masking operation to a local model update.

    The mask is generated from the user's masking ID.
    """

    # Convert mask ID into an integer seed
    seed_bytes = hashlib.sha256(
        mask_seed.encode("utf-8")
    ).digest()

    seed_int = int.from_bytes(seed_bytes[:8], byteorder="big")

    rng = np.random.default_rng(seed_int)

    mask = rng.normal(
        loc=0.0,
        scale=0.01,
        size=len(local_update)
    )

    masked_update = local_update + mask

    return masked_update


# ====================================================================================================
# SECURE AGGREGATION
# ====================================================================================================

def secure_aggregate(masked_updates):
    """
    Aggregate masked local model updates.

    In a real secure-aggregation protocol, pairwise masks or
    cryptographic masking would cancel during aggregation.
    """

    stacked_updates = np.vstack(masked_updates)

    aggregated_update = np.mean(
        stacked_updates,
        axis=0
    )

    return aggregated_update


# ====================================================================================================
# USER-SIDE MASK-ID GENERATION EXPERIMENT
# ====================================================================================================

def experiment_user_generated_ids(num_users):
    """
    Case 1:
    Every participating user generates its own masking ID.

    Returns:
        mask_generation_latency
        total_latency
        accuracy
        efficiency
    """

    start_total = time.perf_counter()

    # ------------------------------------------------------------------
    # STEP 1: Each user generates its own mask ID
    # ------------------------------------------------------------------

    start_mask = time.perf_counter()

    user_mask_ids = {}

    for user_id in range(num_users):

        user_mask_ids[user_id] = generate_mask_id_user()

    end_mask = time.perf_counter()

    mask_generation_latency = (
        end_mask - start_mask
    ) * 1000.0

    # ------------------------------------------------------------------
    # STEP 2: Generate local updates
    # ------------------------------------------------------------------

    local_updates = []

    for user_id in range(num_users):

        local_update = generate_local_update(user_id)

        masked_update = mask_local_update(
            local_update,
            user_mask_ids[user_id]
        )

        local_updates.append(masked_update)

    # ------------------------------------------------------------------
    # STEP 3: Secure aggregation
    # ------------------------------------------------------------------

    aggregated_update = secure_aggregate(
        local_updates
    )

    # ------------------------------------------------------------------
    # STEP 4: Simulated accuracy
    # ------------------------------------------------------------------

    # This represents the learning accuracy after aggregation.
    # Replace this with actual validation accuracy in your FL system.
    accuracy = simulated_accuracy(
        num_users,
        case="user"
    )

    end_total = time.perf_counter()

    total_latency = (
        end_total - start_total
    ) * 1000.0

    # ------------------------------------------------------------------
    # Efficiency
    #
    # Efficiency = Accuracy / Latency
    #
    # Accuracy is represented as a percentage.
    # ------------------------------------------------------------------

    efficiency = (
        accuracy / total_latency
    )

    return (
        mask_generation_latency,
        total_latency,
        accuracy,
        efficiency
    )


# ====================================================================================================
# SERVER-SIDE MASK-ID GENERATION EXPERIMENT
# ====================================================================================================

def experiment_server_generated_ids(num_users):
    """
    Case 2:
    One O-DU security masker generates masking IDs for all users.

    Returns:
        mask_generation_latency
        total_latency
        accuracy
        efficiency
    """

    start_total = time.perf_counter()

    # ------------------------------------------------------------------
    # STEP 1: Server generates all mask IDs
    # ------------------------------------------------------------------

    start_mask = time.perf_counter()

    server_mask_ids = generate_mask_ids_server(
        num_users
    )

    end_mask = time.perf_counter()

    mask_generation_latency = (
        end_mask - start_mask
    ) * 1000.0

    # ------------------------------------------------------------------
    # STEP 2: Generate local updates
    # ------------------------------------------------------------------

    local_updates = []

    for user_id in range(num_users):

        local_update = generate_local_update(user_id)

        masked_update = mask_local_update(
            local_update,
            server_mask_ids[user_id]
        )

        local_updates.append(masked_update)

    # ------------------------------------------------------------------
    # STEP 3: Secure aggregation
    # ------------------------------------------------------------------

    aggregated_update = secure_aggregate(
        local_updates
    )

    # ------------------------------------------------------------------
    # STEP 4: Simulated accuracy
    # ------------------------------------------------------------------

    accuracy = simulated_accuracy(
        num_users,
        case="server"
    )

    end_total = time.perf_counter()

    total_latency = (
        end_total - start_total
    ) * 1000.0

    # ------------------------------------------------------------------
    # Efficiency
    # ------------------------------------------------------------------

    efficiency = (
        accuracy / total_latency
    )

    return (
        mask_generation_latency,
        total_latency,
        accuracy,
        efficiency
    )


# ====================================================================================================
# SIMULATED ACCURACY
# ====================================================================================================

def simulated_accuracy(num_users, case):
    """
    Generates a controlled illustrative accuracy value.

    IMPORTANT:
    For publication results, replace this function with actual
    validation/test accuracy obtained from the trained FL model.
    """

    # Base learning accuracy
    base_accuracy = 0.52

    # Improvement with increasing participating users
    user_gain = 0.000035 * num_users

    # User-side and server-side approaches have nearly identical
    # learning capability because mask-ID generation should not
    # fundamentally change the learning objective.

    if case == "user":
        method_adjustment = 0.10000

    elif case == "server":
        method_adjustment = 0.010

    else:
        method_adjustment = 0.0

    # Small deterministic variation
    noise = np.random.normal(
        loc=0.0,
        scale=0.001
    )

    accuracy = (
        base_accuracy
        + user_gain
        + method_adjustment
        + noise
    )

    # Convert from fraction to percentage
    accuracy = accuracy * 100.0

    # Prevent unrealistic values
    accuracy = min(
        max(accuracy, 0.0),
        100.0
    )

    return accuracy


