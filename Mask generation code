            trial_server_total.append(s_total)

            trial_user_acc.append(u_acc)
            trial_server_acc.append(s_acc)

            trial_user_eff.append(u_eff)
            trial_server_eff.append(s_eff)

        # -------------------------------------------------------------------------------------------
        # Average across trials
