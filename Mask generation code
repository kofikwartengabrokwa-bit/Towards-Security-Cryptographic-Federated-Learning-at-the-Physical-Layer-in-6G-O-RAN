        avg_s_mask = np.mean(trial_server_mask)

        avg_u_total = np.mean(trial_user_total)
        avg_s_total = np.mean(trial_server_total)

        avg_u_acc = np.mean(trial_user_acc)
        avg_s_acc = np.mean(trial_server_acc)

        avg_u_eff = np.mean(trial_user_eff)
        avg_s_eff = np.mean(trial_server_eff)

