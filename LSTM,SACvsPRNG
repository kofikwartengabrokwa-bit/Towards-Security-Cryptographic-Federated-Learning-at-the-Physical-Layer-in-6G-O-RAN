class LSTMThreatPredictor(nn.Module):

    def __init__(
        self,
        input_dim,
        hidden_dim,
        num_layers,
        num_classes
    ):
        super().__init__()

        self.lstm = nn.LSTM(
            input_size=input_dim,
            hidden_size=hidden_dim,
            num_layers=num_layers,
            batch_first=True
        )

        self.fc = nn.Linear(
            hidden_dim,
            num_classes
        )

    def forward(self, x):

        # x shape:
        # [batch_size, sequence_length, input_dim]

        output, _ = self.lstm(x)

        # Use the final time step
        final_output = output[:, -1, :]

        logits = self.fc(
            final_output
        )

        return logits


