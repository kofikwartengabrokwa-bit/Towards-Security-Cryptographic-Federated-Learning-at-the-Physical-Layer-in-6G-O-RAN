train_acc = []

val_loss = []
val_acc = []

test_loss = []
test_acc = []


with open(FILE_PATH, "r", encoding="utf-8") as file:

    for line in file:

        match = pattern.search(line)

        if match:

            epoch = int(match.group(1))

            epochs.append(epoch)

            train_loss.append(float(match.group(3)))
            train_acc.append(float(match.group(4)))

            val_loss.append(float(match.group(5)))
            val_acc.append(float(match.group(6)))

            test_loss.append(float(match.group(7)))
            test_acc.append(float(match.group(8)))


