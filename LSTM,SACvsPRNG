def crypto_cost(
    parameters
):

    key_cost = (
        parameters["key_length"]
        / 128.0
    )

    nonce_cost = (
        parameters["nonce_length"]
        / 96.0
    )

    refresh_cost = (
        1.0
        /
        parameters["refresh_interval"]
    )

    return (
        0.55 * key_cost
        +
        0.20 * nonce_cost
        +
        0.25 * refresh_cost
    )


def resource_efficiency(
    parameters
):

    cost = crypto_cost(
        parameters
    )

    return (
        100.0
        /
        (1.0 + cost)
    )


