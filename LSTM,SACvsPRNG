    )


# ============================================================
# 3. REGULAR EXPRESSION FOR TRAINING LOG
# ============================================================

pattern = re.compile(
    r"Epoch\s*\[(\d+)\s*/\s*(\d+)\]"
    r"\s*\|\s*Train Loss:\s*([\d.eE+-]+)"
    r"\s*\|\s*Train Acc:\s*([\d.eE+-]+)"
    r"\s*\|\s*Val Loss:\s*([\d.eE+-]+)"
    r"\s*\|\s*Val Acc:\s*([\d.eE+-]+)"
    r"\s*\|\s*Test Loss:\s*([\d.eE+-]+)"
    r"\s*\|\s*Test Acc:\s*([\d.eE+-]+)"
)


