def sac_action_to_parameters(action):

    action = np.asarray(
        action,
        dtype=np.float32
    )

    action = np.clip(
        action,
        -1.0,
        1.0
    )

    key_index = int(
        np.round(
            ((action[0] + 1.0) / 2.0)
            * (len(AES_KEY_LENGTHS) - 1)
        )
    )

    nonce_index = int(
        np.round(
            ((action[1] + 1.0) / 2.0)
            * (len(NONCE_LENGTHS) - 1)
        )
    )

    refresh_index = int(
        np.round(
            ((action[2] + 1.0) / 2.0)
            * (len(REFRESH_INTERVALS) - 1)
        )
    )

    key_index = int(
        np.clip(
            key_index,
            0,
            len(AES_KEY_LENGTHS) - 1
        )
    )

    nonce_index = int(
        np.clip(
            nonce_index,
            0,
            len(NONCE_LENGTHS) - 1
        )
    )

    refresh_index = int(
        np.clip(
            refresh_index,
            0,
            len(REFRESH_INTERVALS) - 1
        )
    )

    return {
        "key_length":
            AES_KEY_LENGTHS[key_index],

        "nonce_length":
            NONCE_LENGTHS[nonce_index],

        "refresh_interval":
            REFRESH_INTERVALS[refresh_index]
    }


