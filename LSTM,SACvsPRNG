def create_sequences(
    features,
    labels,
    sequence_length
):

    sequences = []
    sequence_labels = []

    for i in range(
        sequence_length - 1,
        len(features)
    ):

        start = (
            i - sequence_length + 1
        )

        sequences.append(
            features[start:i + 1]
        )

        sequence_labels.append(
            labels[i]
        )

    return (
        np.asarray(
            sequences,
            dtype=np.float32
        ),
        np.asarray(
            sequence_labels,
            dtype=np.int64
        )
    )


