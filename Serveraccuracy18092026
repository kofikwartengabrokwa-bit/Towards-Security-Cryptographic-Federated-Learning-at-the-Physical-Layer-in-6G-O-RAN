def extract_stats(filename):
    """
    Extract round, accuracy, bytes, and clients_used
    for each algorithm from a txt file.
    """

    if not os.path.exists(filename):
        raise FileNotFoundError(
            f"File not found: {os.path.abspath(filename)}"
        )

    with open(filename, "r", encoding="utf-8") as f:
        text = f.read()

    results = {
        "SACFL": {
            "round": [],
            "acc": [],
            "bytes": [],
            "clients_used": []
        },
        "ICFL": {
            "round": [],
            "acc": [],
            "bytes": [],
            "clients_used": []
        },
        "FedGT": {
            "round": [],
            "acc": [],
            "bytes": [],
            "clients_used": []
        },
        "HEFL": {
            "round": [],
            "acc": [],
            "bytes": [],
            "clients_used": []
        }
    }

    # --------------------------------------------------------
    # Match each round
    # --------------------------------------------------------
    round_pattern = re.compile(
        r"Round\s+(\d+):\s*participants=(\d+)(.*?)(?=\n\s*Round\s+\d+:|\Z)",
        re.DOTALL
    )

    # --------------------------------------------------------
    # Match individual algorithm lines
    # --------------------------------------------------------
    algorithm_pattern = re.compile(
        r"(SACFL|ICFL|FedGT|HEFL):\s*"
        r"acc=([0-9.]+),\s*"
        r"bytes=([0-9.eE+-]+),\s*"
        r"clients_used=([0-9]+|None)"
    )

    for round_match in round_pattern.finditer(text):

        round_number = int(round_match.group(1))
        round_content = round_match.group(3)

        algorithm_matches = algorithm_pattern.findall(round_content)

        for algorithm, acc, byte_value, clients_used in algorithm_matches:

            results[algorithm]["round"].append(round_number)
            results[algorithm]["acc"].append(float(acc))
            results[algorithm]["bytes"].append(float(byte_value))

            if clients_used == "None":
                results[algorithm]["clients_used"].append(None)
            else:
                results[algorithm]["clients_used"].append(
                    int(clients_used)
                )

    return results


