            values_1 = [
                value * scale
                for value in stats_1[algorithm][metric]
            ]

            ax.plot(
                rounds_1,
                values_1,
                marker=markers[algorithm],
                linestyle="--",
                markersize=8,
                markerfacecolor="white",
                markeredgewidth=1.8,
                linewidth=1.8,
                label=f"{algorithm} — 1000/200"
            )

    # --------------------------------------------------------
    # Formatting
    # --------------------------------------------------------
