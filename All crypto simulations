# ============================================================================
# FEDPROX LOSS
# ============================================================================

def fedprox_regularization(
    model,
    global_state,
    mu=FEDPROX_MU
):
    """
    Compute the FedProx proximal regularization term:

        (mu / 2) * ||w - w_global||^2

    over all trainable SAC parameters.
    """

    proximal_term = torch.tensor(
        0.0,
        device=DEVICE
    )

    model_state = get_model_parameters(model)

    def recursive_proximal(
        current,
        reference
    ):

        nonlocal proximal_term

        if isinstance(current, dict):

            for key in current.keys():

                if key in reference:

                    recursive_proximal(
                        current[key],
                        reference[key]
                    )

        elif torch.is_tensor(current):

            if (
                torch.is_floating_point(current)
                and torch.is_tensor(reference)
            ):

                reference_tensor = reference.to(
                    device=current.device,
                    dtype=current.dtype
                )

                proximal_term = proximal_term + torch.sum(
                    (current - reference_tensor) ** 2
                )

    recursive_proximal(
        model_state,
        global_state
    )

    return 0.5 * mu * proximal_term


# ============================================================================
# CLIENT LOCAL TRAINING WITH FEDPROX
# ============================================================================

def train_sacdafl_client(
    client_id,
    global_state,
    replay_buffer,
    local_steps=SACDAFL_LOCAL_STEPS
):

    # ============================================================
    # INITIALIZE LOCAL SAC AGENT
    # ============================================================

    client_agent = clone_model(
        global_agent
    )

    set_model_parameters(
        client_agent,
        global_state
    )

    # SACAgent is a custom container, not nn.Module.
    # Do NOT call client_agent.train().

    client_rewards = []
    client_q1 = []
    client_q2 = []
    client_actor = []
    client_alpha = []

    # ============================================================
    # LOCAL SAC TRAINING
    # ============================================================

    for local_step in range(local_steps):

        # --------------------------------------------------------
        # Check replay-buffer size
        # --------------------------------------------------------

        if len(replay_buffer) < BATCH_SIZE:
            continue

        # --------------------------------------------------------
        # Sample mini-batch
        # --------------------------------------------------------

        batch = replay_buffer.sample(
            BATCH_SIZE
        )

        states = torch.as_tensor(
            batch[0],
            dtype=torch.float32,
            device=DEVICE
        )

        actions = torch.as_tensor(
            batch[1],
            dtype=torch.float32,
            device=DEVICE
        )

        rewards = torch.as_tensor(
            batch[2],
            dtype=torch.float32,
            device=DEVICE
        ).unsqueeze(-1)

        next_states = torch.as_tensor(
            batch[3],
            dtype=torch.float32,
            device=DEVICE
        )

        dones = torch.as_tensor(
            batch[4],
            dtype=torch.float32,
            device=DEVICE
        ).unsqueeze(-1)

        # ========================================================
        # SAC TARGET
        # ========================================================

        with torch.no_grad():

            next_action, next_log_prob = (
                client_agent.actor.sample(
                    next_states
                )
            )

            target_q1 = client_agent.target_critic1(
                next_states,
                next_action
            )

            target_q2 = client_agent.target_critic2(
                next_states,
                next_action
            )

            target_q = torch.min(
                target_q1,
                target_q2
            )

            target_q = (
                rewards
                + GAMMA
                * (1.0 - dones)
                * (
                    target_q
                    - client_agent.alpha
                    * next_log_prob
                )
            )

        # ========================================================
        # CRITIC 1 UPDATE
        # ========================================================

        current_q1 = client_agent.critic1(
            states,
            actions
        )

        critic1_loss = F.mse_loss(
            current_q1,
            target_q
        )

        client_agent.critic1_optimizer.zero_grad()

        critic1_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            client_agent.critic1.parameters(),
            MAX_GRAD_NORM
        )

        client_agent.critic1_optimizer.step()

        # ========================================================
        # CRITIC 2 UPDATE
        # ========================================================

        current_q2 = client_agent.critic2(
            states,
            actions
        )

        critic2_loss = F.mse_loss(
            current_q2,
            target_q
        )

        client_agent.critic2_optimizer.zero_grad()

        critic2_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            client_agent.critic2.parameters(),
            MAX_GRAD_NORM
        )

        client_agent.critic2_optimizer.step()

        # ========================================================
        # ACTOR UPDATE + FEDPROX
        # ========================================================

        new_action, log_prob = (
            client_agent.actor.sample(
                states
            )
        )

        q1_new = client_agent.critic1(
            states,
            new_action
        )

        q2_new = client_agent.critic2(
            states,
            new_action
        )

        q_new = torch.min(
            q1_new,
            q2_new
        )

        actor_loss = (
            client_agent.alpha
            * log_prob
            - q_new
        ).mean()

        # --------------------------------------------------------
        # FedProx regularization
        # --------------------------------------------------------

        prox_loss = fedprox_regularization(
            client_agent,
            global_state,
            FEDPROX_MU
        )

        total_actor_loss = (
            actor_loss
            + prox_loss
        )

        client_agent.actor_optimizer.zero_grad()

        total_actor_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            client_agent.actor.parameters(),
            MAX_GRAD_NORM
        )

        client_agent.actor_optimizer.step()

        # ========================================================
        # TEMPERATURE / ALPHA UPDATE
        # ========================================================

        alpha_loss = -(
            client_agent.log_alpha
            * (
                log_prob
                + TARGET_ENTROPY
            ).detach()
        ).mean()

        client_agent.alpha_optimizer.zero_grad()

        alpha_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            [client_agent.log_alpha],
            MAX_GRAD_NORM
        )

        client_agent.alpha_optimizer.step()

        # ========================================================
        # SOFT TARGET UPDATE
        # ========================================================

        with torch.no_grad():

            for target_param, param in zip(
                client_agent.target_critic1.parameters(),
                client_agent.critic1.parameters()
            ):

                target_param.data.mul_(
                    1.0 - TAU
                )

                target_param.data.add_(
                    TAU * param.data
                )

            for target_param, param in zip(
                client_agent.target_critic2.parameters(),
                client_agent.critic2.parameters()
            ):

                target_param.data.mul_(
                    1.0 - TAU
                )

                target_param.data.add_(
                    TAU * param.data
                )

        # ========================================================
        # RECORD STATISTICS
        # ========================================================

        client_rewards.append(
            rewards.mean().item()
        )

        client_q1.append(
            current_q1.mean().item()
        )

        client_q2.append(
            current_q2.mean().item()
        )

        client_actor.append(
            actor_loss.item()
        )

        client_alpha.append(
            client_agent.alpha.item()
        )

    # ============================================================
    # EXTRACT CLIENT MODEL
    # ============================================================

    client_state = get_model_parameters(
        client_agent
    )

    # ============================================================
    # CLIENT STATISTICS
    # ============================================================

    statistics = {
        "reward": (
            np.mean(client_rewards)
            if client_rewards
            else np.nan
        ),

        "q1": (
            np.mean(client_q1)
            if client_q1
            else np.nan
        ),

        "q2": (
            np.mean(client_q2)
            if client_q2
            else np.nan
        ),

        "actor": (
            np.mean(client_actor)
            if client_actor
            else np.nan
        ),

        "alpha": (
            np.mean(client_alpha)
            if client_alpha
            else client_agent.alpha.item()
        )
    }

    return client_state, statistics


# ============================================================================
# MODEL DISTANCE
# ============================================================================

def model_distance(
    state_a,
    state_b
):
    """
    Compute Euclidean distance between two nested SAC parameter states.
    """

    total_distance = 0.0

    def recursive_distance(
        a,
        b
    ):

        nonlocal total_distance

        if isinstance(a, dict):

            for key in a.keys():

                if key in b:

                    recursive_distance(
                        a[key],
                        b[key]
                    )

        elif torch.is_tensor(a):

            if (
                torch.is_floating_point(a)
                and torch.is_tensor(b)
            ):

                a_tensor = a.float()
                b_tensor = b.float()

                total_distance += torch.sum(
                    (a_tensor - b_tensor) ** 2
                ).item()

    recursive_distance(
        state_a,
        state_b
    )

    return float(
        np.sqrt(
            max(total_distance, 0.0)
        )
    )


# ============================================================================
# SECURITY FILTER
# ============================================================================

def filter_malicious_clients(
    global_state,
    client_states,
    threshold=SECURITY_THRESHOLD
):

    if len(client_states) == 0:

        return [], [], []

    distances = []

    for state in client_states:

        distance = model_distance(
            global_state,
            state
        )

        distances.append(
            distance
        )

    distances_np = np.asarray(
        distances,
        dtype=np.float64
    )

    median_distance = np.median(
        distances_np
    )

    # Small epsilon prevents division problems
    reference_distance = max(
        median_distance,
        1e-12
    )

    accepted_indices = []

    rejected_indices = []

    for idx, distance in enumerate(
        distances_np
    ):

        ratio = (
            distance
            / reference_distance
        )

        if ratio <= threshold:

            accepted_indices.append(
                idx
            )

        else:

            rejected_indices.append(
                idx
            )

    # Always retain at least one client
    if len(accepted_indices) == 0:

        accepted_indices = [
            int(
                np.argmin(
                    distances_np
                )
            )
        ]

        rejected_indices = [
            i
            for i in range(
                len(client_states)
            )
            if i not in accepted_indices
        ]

    accepted_states = [
        client_states[i]
        for i in accepted_indices
    ]

    return (
        accepted_states,
        accepted_indices,
        distances
    )


# ============================================================================
# SECURE FEDPROX AGGREGATION
# ============================================================================

def sacdafl_aggregate(
    global_state,
    client_states,
    client_sizes
):

    (
        accepted_states,
        accepted_indices,
        distances
    ) = filter_malicious_clients(
        global_state,
        client_states
    )

    if len(accepted_states) == 0:

        return (
            global_state,
            accepted_indices,
            distances
        )

    accepted_sizes = [
        client_sizes[i]
        for i in accepted_indices
    ]

    aggregated_state = fedavg(
        accepted_states,
        accepted_sizes
    )

    return (
        aggregated_state,
        accepted_indices,
        distances
    )


