# ====================================================================================================
# 12.8 — SAFE ARRAY RETRIEVAL
# ====================================================================================================

def get_array(data, key):
    """
    Safely retrieve a numerical array from an NPZ file.
    """

    if data is None:
        return None

    try:

        if key not in data.files:
            return None

        value = np.asarray(
            data[key],
            dtype=float
        )

        if value.size == 0:
            return None

        return value.reshape(-1)

    except Exception:

        return None


# ====================================================================================================
# 12.9 — FIGURE SAVING
