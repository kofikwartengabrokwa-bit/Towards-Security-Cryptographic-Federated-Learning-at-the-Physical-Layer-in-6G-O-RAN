    def fedavg(client_states, client_sizes):
        """
        Federated Averaging for the nested SACAgent state structure.

        Supports:
            actor
            critic1
            critic2
            target_critic1
            target_critic2
            log_alpha
        """

        if len(client_states) == 0:
            raise ValueError(
                "FedAvg received no client states."
            )

        if len(client_states) != len(client_sizes):
            raise ValueError(
                "Number of client states and client sizes "
                "must be identical."
            )

        total_samples = 2*float(sum(client_sizes))

        if total_samples <= 0:
            raise ValueError(
                "Total number of client samples must be > 0."
            )

        # --------------------------------------------------------
        # Recursive FedAvg
        # --------------------------------------------------------

        def recursive_fedavg(states):

            reference = states[0]

            # ----------------------------------------------------
            # Nested dictionary
            # ----------------------------------------------------

            if isinstance(reference, dict):

                result = {}

                for key in reference.keys():
                    result[key] = recursive_fedavg(
                        [
                            state[key]
                            for state in states
                        ]
                    )

                return result

            # ----------------------------------------------------
            # Tensor
            # ----------------------------------------------------

            if torch.is_tensor(reference):

                # Floating-point tensors
                if torch.is_floating_point(reference):

                    weighted_sum = torch.zeros_like(
                        reference,
                        dtype=torch.float32
                    )

                    for state, size in zip(
                            states,
                            client_sizes
                    ):
                        weight = (
                                float(size)
                                /
                                total_samples
                        )

                        weighted_sum += (
                                state.float()
                                *
                                weight
                        )

                    return weighted_sum.to(
                        dtype=reference.dtype
                    )

                # ------------------------------------------------
                # Integer / Boolean tensors
                # ------------------------------------------------

                return reference.clone()

            # ----------------------------------------------------
            # Unsupported type
            # ----------------------------------------------------

            raise TypeError(
                "Unsupported parameter type in FedAvg: "
                f"{type(reference)}"
            )

        return recursive_fedavg(client_states)
