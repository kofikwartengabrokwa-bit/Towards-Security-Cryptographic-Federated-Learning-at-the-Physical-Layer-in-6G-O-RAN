def train_hefl_client(
    global_state,
    global_agent,
    replay_buffer,
    local_steps
):
    """
    Standard local SAC training for the HEFL baseline.

    IMPORTANT:
    No FedProx regularization, Byzantine filtering, median filtering,
    or ICFL-specific security mechanism is applied here.
    """

    client_agent = clone_model(hefl_global_agent)

    set_model_parameters(
        client_agent,
        hefl_global_state
    )

    rewards_list = []
    q1_list = []
    q2_list = []
    actor_list = []
    alpha_list = []

    for _ in range(local_steps):

        if len(replay_buffer) < BATCH_SIZE:
            continue

        batch = replay_buffer.sample(
            BATCH_SIZE
        )

        states, actions, rewards, next_states, dones = batch

        states = torch.as_tensor(
            states,
            dtype=torch.float32,
            device=DEVICE
        )

        actions = torch.as_tensor(
            actions,
            dtype=torch.float32,
            device=DEVICE
        )

        rewards = torch.as_tensor(
            rewards,
            dtype=torch.float32,
            device=DEVICE
        ).view(-1, 1)

        next_states = torch.as_tensor(
            next_states,
            dtype=torch.float32,
            device=DEVICE
        )

        dones = torch.as_tensor(
            dones,
            dtype=torch.float32,
            device=DEVICE
        ).view(-1, 1)

        # =============================================================
        # TARGET Q VALUE
        # =============================================================

        with torch.no_grad():

            next_actions, next_log_prob = (
                client_agent.actor.sample(
                    next_states
                )
            )

            target_q1 = (
                client_agent.target_critic1(
                    next_states,
                    next_actions
                )
            )

            target_q2 = (
                client_agent.target_critic2(
                    next_states,
                    next_actions
                )
            )

            target_q = torch.min(
                target_q1,
                target_q2
            )

            alpha = (
                client_agent.log_alpha
                .exp()
                .detach()
            )

            target = (
                rewards
                +
                GAMMA
                *
                (1.0 - dones)
                *
                (
                    target_q
                    -
                    alpha
                    *
                    next_log_prob
                )
            )

        # =============================================================
        # CRITIC UPDATE
        # =============================================================

        current_q1 = (
            client_agent.critic1(
                states,
                actions
            )
        )

        current_q2 = (
            client_agent.critic2(
                states,
                actions
            )
        )

        critic1_loss = F.mse_loss(
            current_q1,
            target
        )

        critic2_loss = F.mse_loss(
            current_q2,
            target
        )

        critic_loss = (
            critic1_loss
            +
            critic2_loss
        )

        client_agent.critic_optimizer.zero_grad()

        critic_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            client_agent.critic1.parameters(),
            MAX_GRAD_NORM
        )

        torch.nn.utils.clip_grad_norm_(
            client_agent.critic2.parameters(),
            MAX_GRAD_NORM
        )

        client_agent.critic_optimizer.step()

        # =============================================================
        # ACTOR UPDATE
        # =============================================================

        new_actions, log_prob = (
            client_agent.actor.sample(
                states
            )
        )

        q1_new = (
            client_agent.critic1(
                states,
                new_actions
            )
        )

        q2_new = (
            client_agent.critic2(
                states,
                new_actions
            )
        )

        min_q = torch.min(
            q1_new,
            q2_new
        )

        alpha = (
            client_agent.log_alpha.exp()
        )

        actor_loss = (
            alpha * log_prob
            -
            min_q
        ).mean()

        client_agent.actor_optimizer.zero_grad()

        actor_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            client_agent.actor.parameters(),
            MAX_GRAD_NORM
        )

        client_agent.actor_optimizer.step()

        # =============================================================
        # ALPHA UPDATE
        # =============================================================

        alpha_loss = -(
            client_agent.log_alpha
            *
            (
                log_prob
                +
                TARGET_ENTROPY
            ).detach()
        ).mean()

        client_agent.alpha_optimizer.zero_grad()

        alpha_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            [client_agent.log_alpha],
            MAX_GRAD_NORM
        )

        client_agent.alpha_optimizer.step()

        # =============================================================
        # TARGET CRITIC UPDATE
        # =============================================================

        with torch.no_grad():

            for target_param, param in zip(
                client_agent.target_critic1.parameters(),
                client_agent.critic1.parameters()
            ):

                target_param.data.mul_(
                    1.0 - TAU
                )

                target_param.data.add_(
                    TAU * param.data
                )

            for target_param, param in zip(
                client_agent.target_critic2.parameters(),
                client_agent.critic2.parameters()
            ):

                target_param.data.mul_(
                    1.0 - TAU
                )

                target_param.data.add_(
                    TAU * param.data
                )

        # =============================================================
        # STATISTICS
        # =============================================================

        rewards_list.append(
            rewards.mean().item()
        )

        q1_list.append(
            current_q1.mean().item()
        )

        q2_list.append(
            current_q2.mean().item()
        )

        actor_list.append(
            actor_loss.item()
        )

        alpha_list.append(
            client_agent.log_alpha.exp().item()
        )

    local_state = get_model_parameters(
        client_agent
    )

    statistics = {

        "reward":
            float(np.mean(rewards_list))
            if rewards_list
            else 0.0,

        "q1":
            float(np.mean(q1_list))
            if q1_list
            else 0.0,

        "q2":
            float(np.mean(q2_list))
            if q2_list
            else 0.0,

        "actor":
            float(np.mean(actor_list))
            if actor_list
            else 0.0,

        "alpha":
            float(np.mean(alpha_list))
            if alpha_list
            else client_agent.log_alpha.exp().item()
    }

    return local_state, statistics


