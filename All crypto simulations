    round_start_time = time.perf_counter()

    client_states = []
    client_sizes = []
    client_statistics = []

    # ------------------------------------------------------------------------
    # CLIENT TRAINING
    # ------------------------------------------------------------------------

    for client_id in range(
        SACDAFL_NUM_CLIENTS
    ):

        client_state, statistics = train_sacdafl_client(
            client_id,
            global_state,
            replay_buffer
        )

        # ------------------------------------------------------------
        # SIMULATED MALICIOUS CLIENT
        # ------------------------------------------------------------

        if client_id < SACDAFL_NUM_MALICIOUS:

            client_state = poison_model_update(
                global_state,
                client_state,
                attack_strength=SACDAFL_ATTACK_STRENGTH
            )

        client_states.append(
            client_state
        )

        # Use equal client weight when no explicit local dataset size
        # is available.
        client_sizes.append(
            1
        )

        client_statistics.append(
            statistics
        )

    # ------------------------------------------------------------------------
    # SECURITY + FEDAVG/FEDPROX AGGREGATION
    # ------------------------------------------------------------------------

    aggregation_start = time.perf_counter()

    (
        global_state,
        accepted_indices,
        distances
    ) = sacdafl_aggregate(
        global_state,
        client_states,
        client_sizes
    )

    aggregation_time = (
        time.perf_counter()
        - aggregation_start
    )

    # ------------------------------------------------------------------------
    # UPDATE GLOBAL MODEL
    # ------------------------------------------------------------------------

    set_model_parameters(
        global_agent,
        global_state
    )

    # ------------------------------------------------------------------------
    # CLIENT STATISTICS
    # ------------------------------------------------------------------------

    valid_rewards = [
        x["reward"]
        for x in client_statistics
        if np.isfinite(x["reward"])
    ]

    valid_q1 = [
        x["q1"]
        for x in client_statistics
        if np.isfinite(x["q1"])
    ]

    valid_q2 = [
        x["q2"]
        for x in client_statistics
        if np.isfinite(x["q2"])
    ]

    valid_actor = [
        x["actor"]
        for x in client_statistics
        if np.isfinite(x["actor"])
    ]

    valid_alpha = [
        x["alpha"]
        for x in client_statistics
        if np.isfinite(x["alpha"])
    ]

    mean_reward = (
        np.mean(valid_rewards)
        if valid_rewards
        else np.nan
    )

    mean_q1 = (
        np.mean(valid_q1)
        if valid_q1
        else np.nan
    )

    mean_q2 = (
        np.mean(valid_q2)
        if valid_q2
        else np.nan
    )

    mean_actor = (
        np.mean(valid_actor)
        if valid_actor
        else np.nan
    )

    mean_alpha = (
        np.mean(valid_alpha)
        if valid_alpha
        else global_agent.alpha.item()
    )

    # ------------------------------------------------------------------------
    # SYSTEM METRICS
    # ------------------------------------------------------------------------

    round_latency_ms = (
        time.perf_counter()
        - round_start_time
    ) * 1000.0

    try:

        process = psutil.Process(
            os.getpid()
        )

        memory_mb = (
            process.memory_info().rss
            / (
                1024.0
                * 1024.0
            )
        )

        cpu_percent = (
            process.cpu_percent(
                interval=None
            )
        )

    except Exception:

        memory_mb = np.nan
        cpu_percent = np.nan

    cpu_overhead = cpu_percent

    communication_mb = (
        len(client_states)
        * sum(
            p.numel()
            for p in global_agent.actor.parameters()
        )
        * 4
        / (
            1024.0
            * 1024.0
        )
    )

    # ------------------------------------------------------------------------
    # ENERGY
    # ------------------------------------------------------------------------

    # ------------------------------------------------------------------------
    # ENERGY CONSUMPTION
    # ------------------------------------------------------------------------
    #
    # ICFL uses the same energy definition as SACFL and HEFL:
    #
    #       E = P * t
    #
    # where:
    #
    #       P = CPU_TDP_WATTS * CPU utilization / 100
    #
    # ------------------------------------------------------------------------

    energy_j = estimate_energy_joules(

        cpu_utilization=cpu_percent,

        duration_seconds=round_time,

        cpu_tdp_watts=CPU_TDP_WATTS

    )

    energy_j = float(
        energy_j
    )

    # ------------------------------------------------------------------------
    # SECURITY METRICS
    # ------------------------------------------------------------------------

    num_accepted = len(
        accepted_indices
    )

    num_rejected = (
        SACDAFL_NUM_CLIENTS
        - num_accepted
    )

    if len(distances) > 0:

        mean_distance = float(
            np.mean(
                distances
            )
        )

    else:

        mean_distance = np.nan

    # Packet attack rate
    if SACDAFL_NUM_CLIENTS > 0:

        packet_attack_rate = (
            SACDAFL_NUM_MALICIOUS
            / SACDAFL_NUM_CLIENTS
        ) * 100.0

    else:

        packet_attack_rate = 0.0

    # Successful attack rate:
    # malicious clients that passed the security filter
    malicious_accepted = len([
        idx
        for idx in accepted_indices
        if idx < SACDAFL_NUM_MALICIOUS
    ])

    if SACDAFL_NUM_MALICIOUS > 0:

        successful_attack_rate = (
            malicious_accepted
            / SACDAFL_NUM_MALICIOUS
        ) * 100.0

    else:

        successful_attack_rate = 0.0
    round_duration = (
            time.perf_counter()
            -
            round_start_time
    )

    current_cpu = get_cpu_utilization()
    current_sca = get_cpu_scalability()

    current_alpha = get_sac_alpha(
        global_agent
    )

    current_temperature = get_cpu_temperature()

    current_energy = estimate_energy_joules(
