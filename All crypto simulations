def save_figure(fig, filename):
    """
    Save publication-quality EPS and PNG figures.
    """

    os.makedirs(
        BASE_DIR,
        exist_ok=True
    )

    eps_path = os.path.join(
        BASE_DIR,
        filename + ".eps"
    )

    png_path = os.path.join(
        BASE_DIR,
        filename + ".png"
    )

    try:

        fig.savefig(
            eps_path,
            format="eps",
            dpi=600,
            bbox_inches="tight"
        )

        print(
            f"[SAVED] EPS : {eps_path}"
        )

    except Exception as e:

        print(
            f"[ERROR] EPS save failed: {e}"
        )

    try:

        fig.savefig(
            png_path,
            format="png",
            dpi=600,
            bbox_inches="tight"
        )

        print(
            f"[SAVED] PNG : {png_path}"
        )

    except Exception as e:

        print(
            f"[ERROR] PNG save failed: {e}"
        )


# ====================================================================================================
# 12.10 — FULL BOXED IEEE-STYLE AXIS
# ====================================================================================================

def finish_plot(ax):
    """
    Conventional full rectangular scientific axes.

    Visible:
        - left axis
        - right axis
        - top axis
        - bottom axis

    EPS-safe:
        no transparent plotting elements.
    """

    ax.set_axisbelow(True)

    # Full rectangular frame
    ax.spines["left"].set_visible(True)
    ax.spines["right"].set_visible(True)
    ax.spines["top"].set_visible(True)
    ax.spines["bottom"].set_visible(True)

    for spine in ax.spines.values():
        spine.set_linewidth(1.2)

    # EPS-safe grid
    ax.grid(
        True,
        which="major",
        linestyle="--",
        linewidth=0.7,
        alpha=1.0
    )

    ax.tick_params(
        axis="both",
        which="major",
        direction="out",
        length=6,
        width=1.2
    )


