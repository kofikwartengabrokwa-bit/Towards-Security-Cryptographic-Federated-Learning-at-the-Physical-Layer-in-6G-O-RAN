# IMPORTANT:
#       Round 0 is explicitly included.
#       Therefore, SIX energy samples are required:
#
#       Round 0, 1, 2, 3, 4, 5
#
#       The plot terminates exactly at Round 5.
# ====================================================================================================

print("\n" + "=" * 110)
print("FIGURE 12(h) — ENERGY CONSUMPTION")
print("=" * 110)


# ----------------------------------------------------------------------------------------------------
# FEDERATED ROUND RANGE
# ----------------------------------------------------------------------------------------------------

START_ROUND = 0
END_ROUND = 5

# Number of samples required for:
# Round 0, 1, 2, 3, 4, 5
PLOT_SAMPLES = END_ROUND - START_ROUND + 1


energy_plotted = 0


fig, ax = plt.subplots(
    figsize=(9, 6)
)


# ----------------------------------------------------------------------------------------------------
# LOAD AND PLOT ENERGY DATA
# ----------------------------------------------------------------------------------------------------

for model in MODEL_ORDER:

    if model not in results:

        print(
            f"[INFO] {model}: result file not loaded."
        )

        continue


    energy = get_array(
        results[model],
        "energy_j"
    )


    if energy is None:

        print(
            f"[WARNING] {model}: "
            f"'energy_j' not available in result file."
        )

        continue


    # -----------------------------------------------------------------------------------------------
    # CONVERT TO 1-D NUMPY ARRAY
    # -----------------------------------------------------------------------------------------------

    energy = np.asarray(
        energy,
        dtype=float
    ).reshape(-1)


    # -----------------------------------------------------------------------------------------------
    # CHECK WHETHER ENOUGH SAMPLES EXIST
    #
    # Six samples are required to plot:
    #       Round 0 → Round 5
    # -----------------------------------------------------------------------------------------------

    if len(energy) < PLOT_SAMPLES:

        print(
            f"[WARNING] {model}: only {len(energy)} "
            f"energy samples available, but {PLOT_SAMPLES} "
            f"samples are required for rounds "
            f"{START_ROUND}–{END_ROUND}."
        )

        # Use whatever samples are available, but never exceed Round 5.
        energy = energy[:PLOT_SAMPLES]

    else:

        # Keep ONLY Round 0 through Round 5.
        energy = energy[:PLOT_SAMPLES]


    # -----------------------------------------------------------------------------------------------
    # REMOVE INVALID VALUES
    #
    # The round indices are generated first and then matched with the
    # corresponding finite energy samples.
    # -----------------------------------------------------------------------------------------------

    rounds = np.arange(
        START_ROUND,
        START_ROUND + len(energy)
    )


    valid_mask = np.isfinite(
        energy
    )


    if not np.any(valid_mask):

        print(
            f"[WARNING] {model}: "
            f"no finite energy values available "
            f"for rounds {START_ROUND}–{END_ROUND}."
        )

        continue


    energy = energy[
        valid_mask
    ]

    rounds = rounds[
        valid_mask
    ]


    if len(energy) == 0:

        continue


    # -----------------------------------------------------------------------------------------------
    # PLOT ENERGY CURVE
    #
    # MODEL_ORDER remains:
    #       SACFL → ICFL → HEFL → FedGT
    #
    # Therefore ICFL remains the second plotted model.
