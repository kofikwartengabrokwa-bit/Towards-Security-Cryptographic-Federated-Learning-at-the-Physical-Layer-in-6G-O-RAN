# ====================================================================================================
# MASK-ID GENERATION FUNCTIONS
# ====================================================================================================

def generate_mask_id_user():
    """
    Generate a masking ID at the user side.

    Each user independently creates its own cryptographically
    random masking identifier.
    """

    mask_id = secrets.token_bytes(MASK_ID_BYTES)

    # Hash the random value to obtain a fixed-size identifier
    mask_id = hashlib.sha256(mask_id).hexdigest()

    return mask_id


def generate_mask_ids_server(num_users):
    """
    Generate all masking IDs centrally at the O-DU security masker.

    One server generates IDs for all participating users.
    """

    mask_ids = {}

    for user_id in range(num_users):

        random_value = secrets.token_bytes(MASK_ID_BYTES)

        mask_id = hashlib.sha256(random_value).hexdigest()

        mask_ids[user_id] = mask_id

    return mask_ids


# ====================================================================================================
# SIMULATED LOCAL MODEL UPDATE
# ====================================================================================================

def generate_local_update(user_id, model_dimension=MODEL_DIMENSION):
    """
    Generate a simulated local model update.

    In the actual FL implementation, this should be replaced by
    the local FedProx/LSTM/SAC model update.
    """

    rng = np.random.default_rng(RANDOM_SEED + user_id)

    update = rng.normal(
        loc=0.0,
        scale=0.01,
        size=model_dimension
    )

    return update


# ====================================================================================================
# MASKING FUNCTION
# ====================================================================================================

def mask_local_update(local_update, mask_seed):
    """
    Apply a deterministic masking operation to a local model update.

    The mask is generated from the user's masking ID.
    """

    # Convert mask ID into an integer seed
    seed_bytes = hashlib.sha256(
        mask_seed.encode("utf-8")
    ).digest()

    seed_int = int.from_bytes(seed_bytes[:8], byteorder="big")

    rng = np.random.default_rng(seed_int)

    mask = rng.normal(
        loc=0.0,
        scale=0.01,
        size=len(local_update)
    )

    masked_update = local_update + mask

    return masked_update


# ====================================================================================================
# SECURE AGGREGATION
# ====================================================================================================

def secure_aggregate(masked_updates):
    """
    Aggregate masked local model updates.

    In a real secure-aggregation protocol, pairwise masks or
    cryptographic masking would cancel during aggregation.
    """

    stacked_updates = np.vstack(masked_updates)

    aggregated_update = np.mean(
        stacked_updates,
        axis=0
    )

    return aggregated_update


