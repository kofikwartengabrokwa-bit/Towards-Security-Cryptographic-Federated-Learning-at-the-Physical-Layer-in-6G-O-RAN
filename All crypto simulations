def set_model_parameters(
    model,
    state_dict
):

    if not isinstance(model, SACAgent):

        raise TypeError(
            "set_model_parameters expected SACAgent, "
            f"but received {type(model).__name__}."
        )

    if "actor" in state_dict:

        model.actor.load_state_dict(
            state_dict["actor"]
        )

    if "critic1" in state_dict:

        model.critic1.load_state_dict(
            state_dict["critic1"]
        )

    if "critic2" in state_dict:

        model.critic2.load_state_dict(
            state_dict["critic2"]
        )

    if "target_critic1" in state_dict:

        model.target_critic1.load_state_dict(
            state_dict["target_critic1"]
        )

    if "target_critic2" in state_dict:

        model.target_critic2.load_state_dict(
            state_dict["target_critic2"]
        )

    if "log_alpha" in state_dict:

        with torch.no_grad():

            model.log_alpha.copy_(
                state_dict["log_alpha"].to(
                    model.device
                )
            )

    return model


