# ============================================================
# LOCAL TRAINING
# ============================================================

def local_training(
    global_model,
    client_states,
    client_labels,
    local_steps
):

    """
    Lightweight local SAC training.

    The SAC agent's own update method is used when available.
    """

    local_model = clone_model(
        global_model
    )

    # --------------------------------------------------------
    # Determine available SAC update method
    # --------------------------------------------------------

    update_method = None

    for name in [
        "update",
        "train_step",
        "learn"
    ]:

        if hasattr(
            local_model,
            name
        ):

            update_method = getattr(
                local_model,
                name
            )

            break

    # --------------------------------------------------------
    # If the SAC class does not expose an update method,
    # retain the global model.
    # --------------------------------------------------------

    if update_method is None:

        return get_model_parameters(
            local_model
        )

    # --------------------------------------------------------
    # Local SAC experience
    # --------------------------------------------------------

    n = len(client_states)

    if n == 0:

        return get_model_parameters(
            local_model
        )

    rng = np.random.default_rng(
        SEED
    )

    for step in range(
        local_steps
    ):

        batch_size = min(
            BATCH_SIZE,
            n
        )

        indices = rng.choice(
            n,
            size=batch_size,
            replace=False
        )

        states = client_states[
            indices
        ]

        labels = client_labels[
            indices
        ]

        try:

            # ------------------------------------------------
            # Use the SAC update interface if it accepts
            # state/label information.
            # ------------------------------------------------

            update_method(
                states,
                labels
            )

        except Exception:

            # ------------------------------------------------
            # Some SAC implementations perform updates from
            # their replay buffer rather than direct arrays.
            # In that case, stop local updating gracefully.
            # ------------------------------------------------

            break

    return get_model_parameters(
        local_model
    )


