def _clone_state_dict(state_dict):
    return {
        key: value.detach().cpu().clone()
        for key, value in state_dict.items()
    }


def get_model_parameters(model):

    return {
        "actor": {
            key: value.detach().cpu().clone()
            for key, value in model.actor.state_dict().items()
        },

        "critic1": {
            key: value.detach().cpu().clone()
            for key, value in model.critic1.state_dict().items()
        },

        "critic2": {
            key: value.detach().cpu().clone()
            for key, value in model.critic2.state_dict().items()
        },

        "target_critic1": {
            key: value.detach().cpu().clone()
            for key, value in model.target_critic1.state_dict().items()
        },

        "target_critic2": {
            key: value.detach().cpu().clone()
            for key, value in model.target_critic2.state_dict().items()
        },

        "log_alpha": model.log_alpha.detach().cpu().clone()
    }


