    )

    # Secure aggregation requires:
    #
    # 1. masked model upload from each client
    # 2. global model distribution
    # 3. pairwise mask/key exchange overhead
    #
    # The pairwise masking overhead is represented explicitly.

    pairwise_mask_overhead = (
