# 2. SECURE AGGREGATION MASK GENERATION
# =============================================================================

def fedgt_generate_pairwise_mask(
    shape,
    seed,
    scale=FEDGT_MASK_SCALE
):
    """
    Generate a deterministic pairwise additive mask.

    In an actual distributed cryptographic implementation, the seed would
    originate from a pairwise key-agreement protocol. Here, a deterministic
    seed provides a reproducible simulation of the masking mechanism.

    The mask is generated as an integer vector so that pairwise masks can
    cancel exactly during secure aggregation.
    """

    generator = torch.Generator(
        device="cpu"
    )

    generator.manual_seed(
        int(seed)
    )

    mask = torch.randint(
        low=-scale,
        high=scale,
        size=shape,
        generator=generator,
        dtype=torch.int64
    )

    return mask


# =============================================================================
# 3. PAIRWISE MASKING
# =============================================================================

def fedgt_mask_client_state(
    client_state,
    client_id,
    num_clients
):
    """
    Apply pairwise additive masks to one client's model state.

    For every pair of clients (i,j):

        client i adds  +M_ij
        client j adds  -M_ij

    Therefore, when all masked updates are summed:

        sum(M_ij) + sum(-M_ij) = 0

    and the original aggregate is recovered.
    """

    def recursive_mask(
        value,
        path="root"
    ):

        # -------------------------------------------------------------
        # Nested SAC state
        # -------------------------------------------------------------

        if isinstance(value, dict):

            return {
                key: recursive_mask(
                    subvalue,
                    path + "_" + str(key)
                )
                for key, subvalue in value.items()
            }

        # -------------------------------------------------------------
        # Tensor
        # -------------------------------------------------------------

        if torch.is_tensor(value):

            tensor = value.detach().cpu()

            # ---------------------------------------------------------
            # Floating-point model parameter
            # ---------------------------------------------------------

            if torch.is_floating_point(tensor):

                integer_value = torch.round(
                    tensor.float()
                    *
                    FEDGT_MASK_SCALE
                ).to(torch.int64)

                masked_value = (
                    integer_value.clone()
                )

                # -----------------------------------------------------
                # Generate pairwise masks
                # -----------------------------------------------------

                for other_id in range(
                    num_clients
                ):

                    if other_id == client_id:
                        continue

                    lower_id = min(
                        client_id,
                        other_id
                    )

                    upper_id = max(
                        client_id,
                        other_id
                    )

                    # Deterministic pairwise seed
                    seed_string = (
                        f"{lower_id}_"
                        f"{upper_id}_"
                        f"{path}"
                    )

                    seed = (
                        abs(
                            hash(seed_string)
                        )
                        %
                        (2**31 - 1)
                    )

                    mask = (
                        fedgt_generate_pairwise_mask(
                            integer_value.shape,
                            seed
                        )
                    )

                    # Lower-index client adds mask;
                    # higher-index client subtracts mask.
                    if client_id < other_id:
                        masked_value += mask
                    else:
                        masked_value -= mask

                return masked_value

            # ---------------------------------------------------------
            # Non-floating tensor
            # ---------------------------------------------------------

            return tensor.clone()

        raise TypeError(
            f"Unsupported state type in masking: "
            f"{type(value)}"
        )

    return recursive_mask(
        client_state
    )


# =============================================================================
# 4. SECURE AGGREGATION
# =============================================================================

def fedgt_secure_aggregate(
    masked_states,
    client_sizes
):
    """
    Aggregate masked client models.

    Individual client states remain masked during aggregation.

    Pairwise masks cancel when all participating clients are included.

    The server obtains only the weighted aggregate.
    """

    if len(masked_states) == 0:
        raise ValueError(
            "No client states supplied to FedGT."
        )

    if len(masked_states) != len(client_sizes):
        raise ValueError(
            "Masked states and client sizes "
            "must have identical lengths."
        )

    total_samples = float(
        sum(client_sizes)
    )

    if total_samples <= 0:
        raise ValueError(
            "Total client samples must be greater than zero."
        )

    def recursive_aggregate(states):

        reference = states[0]

        # -------------------------------------------------------------
        # Nested dictionary
        # -------------------------------------------------------------

        if isinstance(reference, dict):

            result = {}

            for key in reference.keys():

                result[key] = recursive_aggregate(
                    [
                        state[key]
                        for state in states
                    ]
                )

            return result

        # -------------------------------------------------------------
        # Masked tensor
        # -------------------------------------------------------------

        if torch.is_tensor(reference):

            if reference.dtype == torch.int64:

                weighted_sum = torch.zeros(
                    reference.shape,
                    dtype=torch.float64
                )

                for state, size in zip(
                    states,
                    client_sizes
                ):

                    weight = (
                        float(size)
                        /
                        total_samples
                    )

                    weighted_sum += (
                        state.double()
                        *
                        weight
                    )

                # Recover floating-point model parameter
                return (
                    weighted_sum
                    /
                    FEDGT_MASK_SCALE
                ).float()

            return reference.clone()

        raise TypeError(
            f"Unsupported aggregation type: "
            f"{type(reference)}"
        )

    return recursive_aggregate(
        masked_states
    )


# =============================================================================
# 5. LOCAL SAC TRAINING FOR FEDGT
# =============================================================================

def train_fedgt_client(
    global_state,
    global_agent,
    replay_buffer,
    local_steps
):
    """
    Standard SAC local training used by the FedGT baseline.

    FedGT differs from SACFL only in the aggregation stage.

    No FedProx regularization, HE, Byzantine filtering, or ICFL-specific
    mechanism is applied.
    """

    client_agent = clone_model(
        global_agent
    )

    set_model_parameters(
        client_agent,
        global_state
    )


    rewards_list = []
    q1_list = []
    q2_list = []
    actor_list = []
    alpha_list = []

    for _ in range(
        local_steps
    ):

        if len(replay_buffer) < BATCH_SIZE:
            continue

        batch = replay_buffer.sample(
            BATCH_SIZE
        )

        states, actions, rewards, next_states, dones = batch

        states = torch.as_tensor(
            states,
            dtype=torch.float32,
            device=DEVICE
        )

        actions = torch.as_tensor(
            actions,
            dtype=torch.float32,
            device=DEVICE
        )

        rewards = torch.as_tensor(
            rewards,
            dtype=torch.float32,
            device=DEVICE
        ).view(-1, 1)

        next_states = torch.as_tensor(
            next_states,
            dtype=torch.float32,
            device=DEVICE
        )

        dones = torch.as_tensor(
            dones,
            dtype=torch.float32,
            device=DEVICE
        ).view(-1, 1)

        # =============================================================
        # TARGET Q
        # =============================================================

        with torch.no_grad():

            next_actions, next_log_prob = (
                client_agent.actor.sample(
                    next_states
                )
            )

            target_q1 = (
                client_agent.target_critic1(
                    next_states,
                    next_actions
                )
            )

            target_q2 = (
                client_agent.target_critic2(
                    next_states,
                    next_actions
                )
            )

            target_q = torch.min(
                target_q1,
                target_q2
            )

            alpha = (
                client_agent.log_alpha
                .exp()
                .detach()
            )

            target = (
                rewards
                +
                GAMMA
                *
                (1.0 - dones)
                *
                (
                    target_q
                    -
                    alpha
                    *
                    next_log_prob
                )
            )

        # =============================================================
        # CRITIC UPDATE
        # =============================================================

        current_q1 = (
            client_agent.critic1(
                states,
                actions
            )
        )

        current_q2 = (
            client_agent.critic2(
                states,
                actions
            )
        )

        critic1_loss = F.mse_loss(
            current_q1,
            target
        )

        critic2_loss = F.mse_loss(
            current_q2,
            target
        )

        critic_loss = (
            critic1_loss
            +
            critic2_loss
        )

        client_agent.critic_optimizer.zero_grad()

        critic_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            client_agent.critic1.parameters(),
            MAX_GRAD_NORM
        )

        torch.nn.utils.clip_grad_norm_(
            client_agent.critic2.parameters(),
            MAX_GRAD_NORM
        )

        client_agent.critic_optimizer.step()

        # =============================================================
        # ACTOR UPDATE
        # =============================================================

        new_actions, log_prob = (
            client_agent.actor.sample(
                states
            )
        )

        q1_new = (
            client_agent.critic1(
                states,
                new_actions
            )
        )

        q2_new = (
            client_agent.critic2(
                states,
                new_actions
            )
        )

        min_q = torch.min(
            q1_new,
            q2_new
        )

        alpha = (
            client_agent.log_alpha.exp()
        )

        actor_loss = (
            alpha * log_prob
            -
            min_q
        ).mean()

        client_agent.actor_optimizer.zero_grad()

        actor_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            client_agent.actor.parameters(),
            MAX_GRAD_NORM
        )

        client_agent.actor_optimizer.step()

        # =============================================================
        # ALPHA UPDATE
        # =============================================================

        alpha_loss = -(
            client_agent.log_alpha
            *
            (
                log_prob
                +
                TARGET_ENTROPY
            ).detach()
        ).mean()

        client_agent.alpha_optimizer.zero_grad()

        alpha_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            [client_agent.log_alpha],
            MAX_GRAD_NORM
        )

        client_agent.alpha_optimizer.step()

        # =============================================================
        # TARGET CRITICS
        # =============================================================

        with torch.no_grad():

            for target_param, param in zip(
                client_agent.target_critic1.parameters(),
                client_agent.critic1.parameters()
            ):

                target_param.data.mul_(
                    1.0 - TAU
                )

                target_param.data.add_(
                    TAU * param.data
                )

            for target_param, param in zip(
                client_agent.target_critic2.parameters(),
                client_agent.critic2.parameters()
            ):

                target_param.data.mul_(
                    1.0 - TAU
                )

                target_param.data.add_(
                    TAU * param.data
                )

        # =============================================================
        # STATISTICS
        # =============================================================

        rewards_list.append(
            rewards.mean().item()
        )

        q1_list.append(
            current_q1.mean().item()
        )

        q2_list.append(
            current_q2.mean().item()
        )

        actor_list.append(
            actor_loss.item()
        )

        alpha_list.append(
            client_agent.log_alpha.exp().item()
        )

    local_state = get_model_parameters(
        client_agent
    )

    statistics = {

        "reward":
            float(np.mean(rewards_list))
            if rewards_list
            else 0.0,

        "q1":
            float(np.mean(q1_list))
            if q1_list
            else 0.0,

        "q2":
            float(np.mean(q2_list))
            if q2_list
            else 0.0,

        "actor":
            float(np.mean(actor_list))
            if actor_list
            else 0.0,

        "alpha":
            float(np.mean(alpha_list))
            if alpha_list
            else client_agent.log_alpha.exp().item()
    }

    return local_state, statistics


