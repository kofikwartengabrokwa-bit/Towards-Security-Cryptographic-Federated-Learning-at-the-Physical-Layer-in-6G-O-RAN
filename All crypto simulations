# ============================================================
# 22. CREATE LSTM SEQUENCES
# ============================================================
#
# The LSTM receives:
#
#       5 consecutive observations
#
# Therefore:
#
# X shape =
#
#       [samples, sequence_length, features]
#
#       [N, 5, 16]
#
# The target is the class associated with the final
# observation in each sequence.
# ============================================================

def create_sequences(
    features,
    labels,
    sequence_length
):

    sequences = []
    sequence_labels = []

    for i in range(
        len(features) - sequence_length + 1
    ):

        sequence = features[
            i:i + sequence_length
        ]

        target = labels[
            i + sequence_length - 1
        ]

        sequences.append(sequence)
        sequence_labels.append(target)

    return (
        np.asarray(
            sequences,
            dtype=np.float32
        ),
