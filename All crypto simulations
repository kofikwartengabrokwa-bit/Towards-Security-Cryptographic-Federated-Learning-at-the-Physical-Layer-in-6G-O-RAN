).to(DEVICE)


# ============================================================
# 11. LSTM MODEL
# ============================================================

class ThreatLSTM(nn.Module):

    def __init__(
        self,
        input_size,
        hidden_size,
        num_layers,
        num_classes,
        dropout
    ):

        super().__init__()

        self.lstm = nn.LSTM(
            input_size=input_size,
            hidden_size=hidden_size,
            num_layers=num_layers,
            batch_first=True,
            dropout=dropout if num_layers > 1 else 0.0
        )

        self.dropout = nn.Dropout(
            dropout
        )

        self.fc = nn.Linear(
            hidden_size,
            num_classes
        )


    def forward(self, x):

        # x:
        # [batch, sequence_length, features]

        output, _ = self.lstm(x)

        # Use the final time step
        final_output = output[:, -1, :]

        final_output = self.dropout(
            final_output
        )

        logits = self.fc(
            final_output
        )

        return logits


# ============================================================
# 12. CREATE MODEL
