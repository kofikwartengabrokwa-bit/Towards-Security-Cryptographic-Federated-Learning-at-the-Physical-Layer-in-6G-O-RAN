# ============================================================

def calculate_parameter_bytes(obj):
    """
    Recursively calculate the total size of all tensor
    parameters in the SAC model state dictionary.
    """

    total_bytes = 0

    if isinstance(obj, dict):

        for value in obj.values():
            total_bytes += calculate_parameter_bytes(value)

    elif torch.is_tensor(obj):

        total_bytes += (
            obj.numel() *
            obj.element_size()
        )

    return total_bytes


