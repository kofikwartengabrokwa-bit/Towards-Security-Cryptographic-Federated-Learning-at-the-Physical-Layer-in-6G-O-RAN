# =============================================================================
# 2. HOMOMORPHIC ENCRYPTION
# =============================================================================

def hefl_encrypt_tensor(tensor, scale=HEFL_SCALE):
    """
    Quantize a floating-point tensor into an integer representation.

    This acts as the encrypted representation used by the simulated
    additive homomorphic aggregation layer.
    """

    if not torch.is_tensor(tensor):
        raise TypeError(
            f"Expected torch.Tensor, got {type(tensor)}"
        )

    tensor_cpu = tensor.detach().cpu()

    if not torch.is_floating_point(tensor_cpu):

        return {
            "data": tensor_cpu.clone(),
            "scale": 1.0,
            "encrypted": False
        }

    integer_data = torch.round(
        tensor_cpu.float() * scale
    ).to(torch.int64)

    return {
        "data": integer_data,
        "scale": float(scale),
        "encrypted": True
    }


def hefl_decrypt_tensor(encrypted_tensor):
    """
    Recover the floating-point tensor after encrypted aggregation.
    """

    if not isinstance(encrypted_tensor, dict):
        raise TypeError(
            "Invalid encrypted tensor representation."
        )

    data = encrypted_tensor["data"]

    if not encrypted_tensor.get(
        "encrypted",
        False
    ):
        return data.clone()

    scale = encrypted_tensor["scale"]

    return (
        data.float() / scale
    )


# =============================================================================
# 3. RECURSIVE STATE ENCRYPTION
# =============================================================================

def hefl_encrypt_state(state):
    """
    Recursively encrypt all SAC model components.

    SAC state structure:

        actor
        critic1
        critic2
        target_critic1
        target_critic2
        log_alpha
    """

    if isinstance(state, dict):

        # Detect encrypted tensor dictionary
        if (
            "data" in state
            and "scale" in state
        ):
            return state

        return {
            key: hefl_encrypt_state(value)
            for key, value in state.items()
        }

    if torch.is_tensor(state):

        return hefl_encrypt_tensor(
            state
        )

    raise TypeError(
        f"Unsupported state type: {type(state)}"
    )


# =============================================================================
# 4. RECURSIVE STATE DECRYPTION
# =============================================================================

def hefl_decrypt_state(state):
    """
    Recursively decrypt the aggregated SAC model.
    """

    if isinstance(state, dict):

        # Encrypted tensor
        if (
            "data" in state
            and "scale" in state
        ):
            return hefl_decrypt_tensor(
                state
            )

        return {
            key: hefl_decrypt_state(value)
            for key, value in state.items()
        }

    if torch.is_tensor(state):

        return state.detach().cpu().clone()

    raise TypeError(
        f"Unsupported state type: {type(state)}"
    )


# =============================================================================
# 5. HOMOMORPHIC WEIGHTED FEDERATED AGGREGATION
# =============================================================================

def hefl_fedavg(encrypted_states, client_sizes):
    """
    Homomorphic weighted aggregation.

    Client model parameters remain in encrypted/integer form during
    aggregation.

    The server decrypts only the final aggregated global model.
    """

    if len(encrypted_states) == 0:
        raise ValueError(
            "No encrypted client states provided."
        )

    if len(encrypted_states) != len(client_sizes):
        raise ValueError(
            "Encrypted states and client sizes "
            "must have identical lengths."
        )

    total_samples = float(
        sum(client_sizes)
    )

    if total_samples <= 0:
        raise ValueError(
            "Total number of client samples "
            "must be greater than zero."
        )

    def recursive_aggregate(states):

        reference = states[0]

        # -------------------------------------------------------------
        # Encrypted tensor
        # -------------------------------------------------------------
        if (
            isinstance(reference, dict)
            and "data" in reference
            and "scale" in reference
        ):

            scale = reference["scale"]

            weighted_sum = torch.zeros(
                reference["data"].shape,
                dtype=torch.float64
            )

            for state, size in zip(
                states,
                client_sizes
            ):

                weight = (
                    float(size)
                    /
                    total_samples
                )

                weighted_sum += (
                    state["data"].double()
                    *
                    weight
                )

            return {
                "data": torch.round(
                    weighted_sum
                ).to(torch.int64),

                "scale": scale,

                "encrypted": reference.get(
                    "encrypted",
                    True
                )
            }

        # -------------------------------------------------------------
        # Nested dictionary
        # -------------------------------------------------------------
        if isinstance(reference, dict):

            result = {}

            for key in reference.keys():

                result[key] = recursive_aggregate(
                    [
                        state[key]
                        for state in states
                    ]
                )

            return result

        raise TypeError(
            f"Unsupported aggregation type: "
            f"{type(reference)}"
        )

    return recursive_aggregate(
        encrypted_states
    )


