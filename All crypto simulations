# ============================================================
# LOCAL SAC TRAINING
# ============================================================

def local_sac_training(
    global_model,
    local_states,
    local_threat_prob,
    local_steps,
    client_seed
):

    # --------------------------------------------------------
    # Create independent local SAC model
    # --------------------------------------------------------

    local_model = clone_model(
        global_model
    )

    # --------------------------------------------------------
    # Local replay buffer
    # --------------------------------------------------------

    replay_buffer = ReplayBuffer(
        LOCAL_BUFFER_SIZE
    )

    n = len(
        local_states
    )

    if n == 0:

        return (
            get_model_parameters(
                local_model
            ),
            [],
            []
        )

    # --------------------------------------------------------
    # Deterministic local RNG
    # --------------------------------------------------------

    rng = np.random.default_rng(
        client_seed
    )

    local_rewards = []

    update_records = []

    # --------------------------------------------------------
    # Collect local SAC experience
    # --------------------------------------------------------

    for step in range(
        local_steps
    ):

        # Select local sample

        sample_index = int(
            rng.integers(
                0,
                n
            )
        )

        state = (
            local_states[
                sample_index
            ]
        )

        threat = (
            local_threat_prob[
                sample_index
            ]
        )

        # ----------------------------------------------------
        # SAC action
        # ----------------------------------------------------

        action = local_model.select_action(
            state,
            evaluate=False
        )

        # ----------------------------------------------------
        # Construct reward using the SAME SAC
        # environment logic from Block 6
        #
        # The first threat probability corresponds to
        # benign probability in the existing environment.
        # ----------------------------------------------------

        threat_level = (
            1.0 - float(threat[0])
        )

        resource_action = (
            float(action[0]) + 1.0
        ) / 2.0

        security_action = (
            float(action[1]) + 1.0
        ) / 2.0

        power_action = (
            float(action[2]) + 1.0
        ) / 2.0

        rate_reward = (
            0.5 * resource_action
            +
            0.3 * power_action
        )

        security_reward = (
            security_action
            *
            threat_level
        )

        latency_penalty = (
            0.25 * resource_action
            +
            0.15 * power_action
        )

        energy_penalty = (
            0.20 * power_action
        )

        computation_penalty = (
            0.10 * security_action
        )

        attack_penalty = (
            threat_level
            *
            (1.0 - security_action)
        )

        reward = (

            2.0 * rate_reward

            +

            3.0 * security_reward

            -

            1.5 * latency_penalty

            -

            1.0 * energy_penalty

            -

            0.5 * computation_penalty

            -

            4.0 * attack_penalty
        )

        # ----------------------------------------------------
        # Next state
        # ----------------------------------------------------

        next_index = (
            (sample_index + 1)
            % n
        )

        next_state = (
            local_states[
                next_index
            ]
        )

        done = False

        # ----------------------------------------------------
        # Store transition
        # ----------------------------------------------------

        # ============================================================
        # STORE EXPERIENCE IN REPLAY BUFFER
        # ============================================================

        replay_buffer.push(
            state,
            action,
            reward,
            next_state,
            done
        )

        local_rewards.append(
            reward
        )

        # ----------------------------------------------------
        # SAC update
        #
        # Block 6 update() requires a replay buffer.
        # Therefore, update only after enough samples exist.
        # ----------------------------------------------------

        if len(replay_buffer) >= BATCH_SIZE:

            update_result = (
                local_model.update(
                    replay_buffer
                )
            )

            update_records.append(
                update_result
            )

    # --------------------------------------------------------
    # Return locally trained model
    # --------------------------------------------------------

    return (
        get_model_parameters(
            local_model
        ),
        local_rewards,
        update_records
    )


