# Class weights reduce the influence of class imbalance.
#
# Weight for class c:
#
#       N
# w_c = ------
#       C*N_c
#
# where:
#
# N   = total training samples
# C   = number of classes
# N_c = samples in class c
# ============================================================

class_counts = np.bincount(
    y_train,
    minlength=NUM_CLASSES
)

total_samples = len(y_train)

class_weights = (
    total_samples /
    (NUM_CLASSES * class_counts)
)


