# -------------------------------------------------------------------------
# Homomorphic-encryption simulation parameters
# -------------------------------------------------------------------------
#
# The model parameters are quantized before encrypted aggregation.
# This provides an additive homomorphic aggregation abstraction without
# requiring an external HE package.
#
# If you later use a real CKKS/BFV implementation from [21], this section
# can be replaced by the actual encryption/decryption operations.
# -------------------------------------------------------------------------

HEFL_SCALE = 1_000_000


