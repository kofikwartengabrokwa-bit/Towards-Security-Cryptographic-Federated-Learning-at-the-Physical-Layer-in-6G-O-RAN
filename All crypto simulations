            return sum(
                fedgt_state_bytes(
                    value
                )
                for value in state.values()
            )

        if torch.is_tensor(state):

            return (
                state.numel()
                *
                state.element_size()
            )

        return 0

    model_bytes = fedgt_state_bytes(
