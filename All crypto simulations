# Approximate CPU TDP used for energy estimation.
# Change this if your experimental machine's CPU TDP is known.
CPU_TDP_WATTS = 65.0


def get_cpu_utilization():
    """
    Return current CPU utilization as a percentage.
    """
    if psutil is None:
        return 0.0

    try:
        return float(psutil.cpu_percent(interval=None))
    except Exception:
        return 0.0

def get_cpu_scalability():
    """
    Return current CPU Scalability as a percentage.
    """
    if psutil is None:
        return 0.0

    try:
        return float(psutil.cpu_percent(interval=None))
    except Exception:
        return 0.0
def get_cpu_temperature():
    """
    Try to obtain physical CPU temperature.

    Windows systems may not expose temperature through psutil.
    If unavailable, return NaN rather than inventing a temperature.
    """

    if psutil is None:
        return float("nan")

    try:
        sensors = psutil.sensors_temperatures()

        if not sensors:
            return float("nan")

        # Look for common CPU temperature sensors.
        preferred = [
            "coretemp",
            "cpu_thermal",
            "k10temp",
            "acpitz",
            "zenpower"
        ]

        for name in preferred:
            if name in sensors:
                entries = sensors[name]

                valid = [
                    entry.current
                    for entry in entries
                    if entry.current is not None
                ]

                if valid:
                    return float(sum(valid) / len(valid))

        # Fallback: use the first available temperature sensor.
        for entries in sensors.values():

            valid = [
                entry.current
                for entry in entries
                if entry.current is not None
            ]

            if valid:
                return float(sum(valid) / len(valid))

    except Exception:
        pass

    return float("nan")


# =============================================================================
# ENERGY CONSUMPTION UTILITY
# =============================================================================
# Consistent CPU-based energy estimation for all FL models.
#
# Energy:
#
#       E = P * t
#
# where:
#
#       P = P_TDP * CPU_Utilization / 100
#
# Therefore:
#
#       E = P_TDP * (CPU_Utilization / 100) * duration
#
# The result is reported in Joules.
#
# This implementation is intentionally independent of Intel RAPL so that
# SACFL, ICFL, and HEFL can be compared consistently on Windows and Linux.
# =============================================================================

CPU_TDP_WATTS = 65.0


def estimate_energy_joules(
        cpu_utilization,
        duration_seconds,
        cpu_tdp_watts=CPU_TDP_WATTS
):
    """
    Estimate CPU energy consumption in Joules.

    Parameters
    ----------
    cpu_utilization : float
        CPU utilization in percent, 0--100.

    duration_seconds : float
        Duration of the federated round in seconds.

    cpu_tdp_watts : float
        Assumed CPU thermal design power in watts.

    Returns
    -------
    float
        Estimated energy consumption in Joules.
    """

    try:

        utilization = float(cpu_utilization)

    except Exception:

        utilization = 0.0

    try:

        duration_seconds = float(duration_seconds)

    except Exception:

        duration_seconds = 0.0

    # Sanitize CPU utilization.
    utilization = np.clip(
        utilization,
        0.0,
        100.0
    )

    # Sanitize duration.
    duration_seconds = max(
        duration_seconds,
        0.0
    )

    # CPU power corresponding to the measured utilization.
    power_watts = (
        float(cpu_tdp_watts)
        *
        utilization
        /
        100.0
    )

    # E = P * t
    energy_joules = (
        power_watts
        *
        duration_seconds
    )

    return float(
        max(
            energy_joules,
            0.0
        )
    )


def get_sac_alpha(agent):
    """
    Obtain SAC entropy temperature alpha.
    """

    try:
        return float(
            torch.exp(
                agent.log_alpha.detach()
            ).cpu().item()
        )
    except Exception:
        return float("nan")


def get_process_memory_mb():
    """
    Return current Python process memory usage.
    """

    if psutil is None:
        return 0.0

    try:
        process = psutil.Process(
            os.getpid()
        )

        return float(
            process.memory_info().rss
            /
            (1024 ** 2)
        )

    except Exception:
        return 0.0
